{
  "name": "Haystack (Go & Python)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/danzilberdan/devcontainers/opencode:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "go.coverOnSave": true,
        "go.coverOnSingleTest": true,
        "go.coverageDecorator": {
          "type": "gutter"
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "always"
          }
        }
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    {
      "source": "${localEnv:HOME}/.local/share/opencode",
      "target": "/dc/opencode/data",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.config/opencode",
      "target": "/dc/opencode/config",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/.local/state/opencode",
      "target": "/dc/opencode/state",
      "type": "bind"
    }
  ],
  "postCreateCommand": "mkdir -p ~/.local/share ~/.config ~/.local/state && ln -sfn /dc/opencode/data ~/.local/share/opencode && ln -sfn /dc/opencode/config ~/.config/opencode && ln -sfn /dc/opencode/state ~/.local/state/opencode"
}
