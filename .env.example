# ==============================================================================
# Haystack Security Scanner Environment Variables
# ==============================================================================
# Copy this file to .env and configure values as needed for your environment.
# All environment variables are optional; Haystack defaults to offline heuristic
# static analysis if external providers are not configured.

# ------------------------------------------------------------------------------
# 1. Classifier Engine Configuration
# ------------------------------------------------------------------------------
# Decision provider for classifying vulnerability findings.
# Options:
#   - heuristic  : Built-in deterministic static analysis (offline, default)
#   - jev        : Just-in-time Exploit / Vulnerability triage (via OpenRouter)
#   - kev        : Known Exploited Vulnerability triage (via local/remote Kev service)
#   - rlcd       : Remote Reinforcement Learning / Canonical Decision API
#   - openrouter : Alias for jev provider
# Default: heuristic
CLASSIFIER_PROVIDER=heuristic

# Remote RLCD / Kev model identifier (e.g. heuristic, kev, jev, rlcd, or custom)
# Default: heuristic
RLCD_MODEL=heuristic
# Fallback alias for RLCD_MODEL
# KEV_MODEL=heuristic

# Remote RLCD / Kev inference endpoint URL
# Default: "" (empty)
# RLCD_API_URL=https://rlcd.internal/v1/classify
# Fallback alias for RLCD_API_URL
# KEV_API_URL=https://rlcd.internal/v1/classify

# Authentication API key / Bearer token for remote RLCD / Kev endpoint
# Default: "" (empty)
# RLCD_API_KEY=your_remote_api_key_here
# Fallback alias for RLCD_API_KEY
# KEV_API_KEY=your_remote_api_key_here

# ------------------------------------------------------------------------------
# 2. OpenRouter / Jev Classifier Configuration
# ------------------------------------------------------------------------------
# Required when CLASSIFIER_PROVIDER is set to "jev" or "openrouter".
# Get an API key from https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter model identifier used for security triage.
# Examples: openrouter/free, anthropic/claude-3.5-sonnet, meta-llama/llama-3-70b-instruct
# Default: openrouter/free
OPENROUTER_MODEL=openrouter/free

# Base URL for OpenRouter API (or any compatible OpenAI API proxy)
# Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 3. Local Kev Microservice Configuration
# ------------------------------------------------------------------------------
# Endpoint for a locally or privately hosted Kev classification service.
# Default: http://localhost:8080/classify
KEV_URL=http://localhost:8080/classify
# Fallback alias for KEV_URL
# KEV_ENDPOINT=http://localhost:8080/classify

# ------------------------------------------------------------------------------
# 4. GitHub & Issue Tracking Integration (MCP Server / CI)
# ------------------------------------------------------------------------------
# Personal access token with repo/issues scope for automated issue creation,
# deduplication, updating, and closing via the Haystack MCP server write tools.
# In GitHub Actions, secrets.GITHUB_TOKEN is automatically provided.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback alias for GITHUB_TOKEN (e.g. from GitHub CLI)
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository in "owner/repo" format for issue tracking.
# Automatically set in GitHub Actions runner environment.
# GITHUB_REPOSITORY=owner/repository
